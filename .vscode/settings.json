{
  "explorer.fileNesting.enabled": true,
  "explorer.sortOrder": "type",
  "explorer.sortOrderLexicographicOptions": "upper",
  "explorer.fileNesting.patterns": {
    "eslint.config.ts": ".eslint*, eslint*, blueprint.config.mjs, .blueprint-baseline.json",
    "package.json": "package-lock.json, .npmrc, .nvmrc",
    "tsconfig.json": "tsconfig.*.json",
    "vite.config.ts": "vitest.config.*, index.html"
  },
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "eslint.format.enable": true,
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  }
}
