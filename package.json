{
  "name": "cards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "architecture": "blueprint inspect",
    "architecture-docs": "blueprint init --no-install",
    "architecture-doctor": "blueprint doctor",
    "build": "tsc -b && cross-env NODE_ENV=production vite build",
    "dev": "vite",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "preview": "vite preview",
    "quality": "npm run lint && npm run tsc && npm test && npm run architecture && npm run architecture-doctor && npm run knip",
    "test": "vitest run",
    "tsc": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^12.23.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "styled-components": "^6.1.19",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@kekkai/blueprint": "^4.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.42.1",
    "lint-staged": "^16.2.6",
    "type-fest": "^5.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "npm:rolldown-vite@7.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
